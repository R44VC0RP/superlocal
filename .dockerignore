# Allow only build/runtime inputs; private config, mail, keys, QA and Git history
# never enter the build context or image layers.
**
!Dockerfile
!.dockerignore
!package.json
!bun.lock
!scripts/
!scripts/dev.ts
!apps/
!apps/shared/
!apps/shared/**
!apps/web/
!apps/web/package.json
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/index.html
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/assets/
!apps/web/public/assets/**
!apps/local-host/
!apps/local-host/package.json
!apps/local-host/src/
!apps/local-host/src/**
!apps/mock-api/
!apps/mock-api/package.json
!apps/mock-api/src/
!apps/mock-api/src/**
!packages/
!packages/inbox-sdk/
!packages/inbox-sdk/package.json
!packages/inbox-sdk/src/
!packages/inbox-sdk/src/**
!packages/inbox-sdk/server/
!packages/inbox-sdk/server/**
**/node_modules
**/dist
**/data
**/.env*
**/*non-gittract*
**/superlocal.local.json
**/runtime-secrets.json
**/*.sqlite*
**/*.pem
**/*.key
**/*.log
**/*.tsbuildinfo
