{
  "name": "inbox-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Headless multi-account inbox API and provider SDK extracted from OpenMail",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/contracts.ts",
    "./provider": "./server/sdk/types.ts",
    "./providers": "./src/providers.ts",
    "./client": "./src/client.ts",
    "./http": "./src/http.ts"
  },
  "engines": { "bun": ">=1.4.0" },
  "scripts": {
    "dev": "bun run scripts/dev-bootstrap.ts",
    "start": "bun run server/index.ts",
    "connect": "bun run scripts/connect.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test tests/provider.test.ts tests/api.test.ts",
    "test:provider": "bun test tests/provider.test.ts",
    "test:api": "bun test tests/api.test.ts"
  },
  "dependencies": {
    "effect": "3.22.1",
    "busboy": "^1.6.0",
    "hono": "^4.8.0",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^10.1.0",
    "imapflow": "^1.0.195",
    "juice": "^12.1.2",
    "nodemailer": "^9.0.5",
    "openid-client": "^6.8.4",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "postcss-value-parser": "4.2.0",
    "sanitize-html": "^2.14.0",
    "saxes": "6.0.0",
    "tldts": "^7.4.11",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/busboy": "^1.5.4",
    "@types/html-to-text": "^9.0.4",
    "@types/nodemailer": "^7.0.0",
    "@types/sanitize-html": "^2.16.0",
    "typescript": "^5.8.0"
  }
}
