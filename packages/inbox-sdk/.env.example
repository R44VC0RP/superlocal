# bun run dev generates independent private .env.local credentials automatically.
# The standalone service is one principal. Multi-user hosts supply authenticate
# to createInboxApi rather than trusting an owner ID sent by the browser.
INBOX_API_TOKEN=
CREDENTIAL_ENCRYPTION_KEY=
INBOX_OWNER_ID=local
PORT=8788
HOST=127.0.0.1
DATABASE_PATH=./data/inbox-v1.sqlite
INBOX_SYNC_INTERVAL_MS=15000
INBOX_ALLOW_PROVIDER_WRITES=false
# INBOX_PROVIDERS=gmail,outlook,imap,inbound
# TRUSTED_ORIGINS=https://mail.example.com

# Configure your Google OAuth web application on the server, not in a browser bundle.
# Register this exact redirect in Google Cloud Console:
# GOOGLE_REDIRECT_URI=http://localhost:8788/v1/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The read-only pilot requests Gmail readonly + OpenID/email. Enabling provider
# writes requests modify/send on the next OAuth connection or reconnect.

# Optional CLI-only credential for `bun run connect inbound`. It is submitted to
# your authenticated local SDK and stored encrypted, never printed by the command.
# INBOUND_API_KEY=
# INBOX_URL=http://localhost:8788

# Provider secrets are supplied to authenticated connection creation, encrypted
# in SQLite, and never included in events or ordinary account responses.
# Live provider qualification is never enabled by an ordinary bun test:
# INBOX_TEST_LIVE=true
# INBOX_TEST_PROVIDER=gmail
# INBOX_TEST_CREDENTIALS={...}
# INBOX_TEST_SENDER=your-test-mailbox@example.com
# INBOX_TEST_RECIPIENT=your-test-mailbox@example.com
# INBOX_TEST_SECOND_CREDENTIALS={...}
